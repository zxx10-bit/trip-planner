# Hugging Face Spaces 部署用的 Dockerfile
# 作用：告诉 HF 服务器如何构建后端运行环境
# 部署到 HF Space 仓库时此文件会被重命名为 Dockerfile（放在仓库根目录）

# 使用 Python 3.11 官方精简镜像（与本地开发版本一致）
FROM python:3.11-slim

# 容器内的工作目录
WORKDIR /code

# 先只复制依赖清单并安装，利用 Docker 缓存加速构建
COPY backend/requirements.txt /code/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# 复制后端应用代码
COPY backend/app /code/app

# HF Space 要求服务监听 7860 端口
EXPOSE 7860

# 启动命令：直接用 uvicorn 运行 FastAPI（线上不使用热重载）
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "7860"]
